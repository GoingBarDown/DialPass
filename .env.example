# Copy to .env and fill in. Nothing here is needed for `make sim`.

# --- HTTP server ---
DIALPASS_HOST=0.0.0.0
DIALPASS_PORT=8000
DIALPASS_LOG_LEVEL=INFO

# --- Detection loop tuning (M3) ---
DIALPASS_FRAME_MS=20
DIALPASS_CLASSIFIER_INTERVAL_MS=500
DIALPASS_BUFFER_SECONDS=12

# --- Telephony (M2+) ---
DIALPASS_TWILIO_ACCOUNT_SID=
DIALPASS_TWILIO_AUTH_TOKEN=
DIALPASS_TWILIO_FROM_NUMBER=
# Public URL Twilio can reach for webhooks + the media WebSocket (e.g. an ngrok https URL)
DIALPASS_PUBLIC_BASE_URL=
# Dev only: if set, each call's decoded PCM is saved to <dir>/<call_id>.wav (M3 tuning)
DIALPASS_RECORD_DIR=

# --- Realtime / Tier 2 (M4+) ---
DIALPASS_OPENAI_API_KEY=
DIALPASS_REALTIME_MODEL=gpt-realtime-mini
